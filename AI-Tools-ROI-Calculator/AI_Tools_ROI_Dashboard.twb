      <column caption='[ROI Percentage]' datatype='string' name='[Calculation_1599831409999889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ROI_Percentage] &gt;= 100 THEN &quot;High ROI&quot;&#13;&#10;ELSEIF [ROI_Percentage] &gt;= 0 THEN &quot;Positive ROI&quot;&#13;&#10;ELSE &quot;Negative ROI&quot;&#13;&#10;END' />
      </column>
      <column caption='ROI Category' datatype='string' name='[Calculation_1599831412211731]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([ROI_Percentage]) &gt;= 10 THEN &quot;High ROI&quot;&#13;&#10;ELSEIF AVG([ROI_Percentage]) &gt;= 0 THEN &quot;Positive ROI&quot;&#13;&#10;ELSE &quot;Negative ROI&quot;&#13;&#10;END' />
